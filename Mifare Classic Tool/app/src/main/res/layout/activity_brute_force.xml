<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayoutBruteForce"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context="Activities.BruteForce" >

    <LinearLayout
        android:id="@+id/linearLayoutBruteForce"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:orientation="vertical" >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_key_type" />

                    <RadioGroup
                        android:id="@+id/radioGroupBruteForceKeyType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:orientation="horizontal" >

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceKeyTypeBoth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/text_key_type_both" />

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceKeyTypeA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_key_type_a" />

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceKeyTypeB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/text_key_type_b" />

                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_key_source" />

                    <RadioGroup
                        android:id="@+id/radioGroupBruteForceKeySource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:orientation="horizontal" >

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceKeySourceRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:onClick="onKeySourceChanged"
                            android:text="@string/text_key_source_range" />

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceKeySourceFile"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="onKeySourceChanged"
                            android:text="@string/text_key_source_file" />

                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutBruteForceKeyRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_key_range_from" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/editTextBruteForceKeyRangeFrom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:digits="0123456789ABCDEFabcdef"
                        android:inputType="text"
                        android:maxLength="12"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_key_range_to" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/editTextBruteForceKeyRangeTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:digits="0123456789ABCDEFabcdef"
                        android:inputType="text"
                        android:maxLength="12"
                        android:singleLine="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutBruteForceKeyFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone" >

                    <Button
                        android:id="@+id/buttonBruteForceChooseKeyFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="onChooseKeyFile"
                        android:text="@string/action_choose_key_file" />

                    <TextView
                        android:id="@+id/textViewBruteForceKeyFiles"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:text="" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_sectors" />

                    <RadioGroup
                        android:id="@+id/radioGroupBruteForceSectorMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:orientation="horizontal" >

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceSectorAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:onClick="onSectorModeChanged"
                            android:text="@string/text_all_sectors" />

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceSectorRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="onSectorModeChanged"
                            android:text="@string/text_sector_mode_range" />

                        <RadioButton
                            android:id="@+id/radioButtonBruteForceSectorPick"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:onClick="onSectorModeChanged"
                            android:text="@string/text_sector_mode_pick" />

                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutBruteForceSectorRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone" >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_from" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/editTextBruteForceSectorFrom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/text_to" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/editTextBruteForceSectorTo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:singleLine="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearLayoutBruteForceSectorPick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/text_found_keys_log" />

                <TextView
                    android:id="@+id/textViewBruteForceKeyLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:minHeight="48dp"
                    android:text=""
                    android:textIsSelectable="true" />

            </LinearLayout>

        </ScrollView>

        <ProgressBar
            android:id="@+id/progressBarBruteForce"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="1"
            android:progress="0" />

        <TextView
            android:id="@+id/textViewBruteForceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal" >

            <Button
                android:id="@+id/buttonBruteForceStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:onClick="onStartBruteForce"
                android:text="@string/action_start" />

            <Button
                android:id="@+id/buttonBruteForcePause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:onClick="onPauseBruteForce"
                android:text="@string/action_pause" />

            <Button
                android:id="@+id/buttonBruteForceCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:onClick="onCancelBruteForce"
                android:text="@string/action_cancel" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
